# Google Sheets Configuration
# Estas variables ahora se leen en el backend.

GOOGLE_SHEETS_ID=1HI0uajmoDquzkUovmVM-M9k1YE1H6QhBNuxdUduIeRA
GOOGLE_SHEETS_API_KEY=AIzaSyCBiFrpTNh4WYx97nxczwhMq4ULVLK0UCM

# Ejemplo (no usar en produccion):
# GOOGLE_SHEETS_ID=1a2b3c4d5e6f7g8h9i0j1k2l3m4n5o6p
# GOOGLE_SHEETS_API_KEY=AIzaSyA1b2C3d4E5f6G7h8I9j0K1l2M3n4O5p6Q

# Google OAuth 2.0 Configuration
# Obten tu Client ID en: https://console.cloud.google.com/
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE

# Backend API
# Desarrollo local con Vite usa el proxy /api automaticamente.
# En produccion con Render en un solo servicio, deja /api.
# Si frontend y backend viven en dominios distintos, usa la URL completa del backend.
# Ejemplo con Render separado:
# VITE_API_URL=https://desarrollo-web-4ec5.onrender.com/api
VITE_API_URL=/api
VITE_SITE_URL=http://localhost:5173

# Environment
VITE_ENV=development

# Session Security
SESSION_TTL_HOURS=168
SESSION_COOKIE_NAME=ztar_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
FRONTEND_ORIGIN=http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=

