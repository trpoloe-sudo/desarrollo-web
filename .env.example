# Google Sheets Configuration
# Estas variables ahora se leen en el backend.

GOOGLE_SHEETS_ID=your_google_sheets_id
GOOGLE_SHEETS_API_KEY=your_google_sheets_api_key

# OAuth / Google Sign-In
# No hay fallback en el codigo: si no configuras este valor, el boton de Google se oculta.
GOOGLE_CLIENT_ID=your_google_client_id
VITE_GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_ALLOWED_CLIENT_IDS=

# Backend API
# Desarrollo local con Vite usa el proxy /api automaticamente.
# En produccion con Render en un solo servicio, deja /api.
# Si frontend y backend viven en dominios distintos, usa la URL completa del backend.
# Ejemplo con Render separado:
VITE_API_URL=https://desarrollo-web-4ec5-0ppe.onrender.com/api
VITE_SITE_URL=http://localhost:5173
VITE_ROUTER_MODE=hash
VITE_HUBSPOT_PORTAL_ID=

# Environment
VITE_ENV=development

# Session Security
SESSION_TTL_HOURS=168
SESSION_COOKIE_NAME=ztar_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
FRONTEND_ORIGIN=https://ansemenu.webcindario.com
CLIENT_ORIGIN=https://ansemenu.webcindario.com
CORS_ORIGIN=https://ansemenu.webcindario.com
ALLOWED_ORIGINS=https://ansemenu.webcindario.com,https://ztartech.webcindario.com

# Tracking opcional
# Deja vacio cualquier valor que no uses.
VITE_GOOGLE_ADS_SEND_TO=
VITE_GA_MEASUREMENT_ID=
VITE_FACEBOOK_PIXEL_ID=
VITE_TIKTOK_PIXEL_ID=

# Alertas operativas opcionales
# Puedes usar Resend para email, WhatsApp Cloud API o un webhook tipo Make/n8n/Zapier.
ALERT_APP_NAME=Ztar Tech
ALERT_WEBHOOK_URL=
ORDER_ALERT_WEBHOOK_URL=
LEAD_ALERT_WEBHOOK_URL=

RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TO_EMAIL=

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ALERT_TO=
WHATSAPP_API_VERSION=v22.0
